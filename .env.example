# Copia para .env.local e ajusta.

# Endereço da API Java. Em produção, o domínio público da API.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Usado nos metadados, nos canónicos e no sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional. Se estiver definido, cada mensagem de contacto também é enviada
# para este webhook do Discord, além de ficar guardada no painel.
# WEBHOOK_URL=
